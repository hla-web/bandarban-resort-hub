{
  "name": "bandarban-resort-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "clientend",
    "adminend",
    "backend",
    "hotelend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=@bandarban/clientend && npm run build --workspace=@bandarban/adminend && npm run build --workspace=@bandarban/hotelend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspace=@bandarban/backend",
    "start": "node scripts/dev.mjs --built"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
