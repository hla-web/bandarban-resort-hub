# SQLite works locally without configuration. Node 24+ required.
PORT=4000
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Optional MySQL 8+ database (create an empty database first):
# DATABASE_URL=mysql://resorthub:password@127.0.0.1:3306/resorthub
# Optional local upload storage directory (defaults to backend/.data/uploads):
# UPLOAD_DIR=
# Required in production; set a random secret of at least 32 characters:
# JWT_SECRET=
